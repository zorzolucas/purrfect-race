        {
          "texto": "Ler e guardar com carinho",
          "efeitos": {
            "humor": 2
          },
          "resultado": "{nome} cola as cartas favoritas na parede do quarto."
        }
      ]
    },
    {
      "id": "mercado",
      "titulo": "Mercado de pulgas",
      "texto": "Na feira do bairro, uma senhora vende amuletos antigos. Ela aceita trocar um por anotações de treino de {nome}.",
