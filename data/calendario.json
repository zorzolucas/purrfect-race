        {
          "texto": "Tentar dormir de novo",
          "efeitos": {
            "energia": -5
          },
          "resultado": "{nome} dorme mal, mas dorme."
        }
      ]
    },
    {
      "id": "fas",
      "titulo": "Cartas de fãs",
      "texto": "Chega uma caixa cheia de cartas para {nome}. Algumas vêm de crianças de outras cidades.",
      "escolhas": [
        {
          "texto": "Responder todas",
          "efeitos": {
            "fama": 150,
            "energia": -10
          },
          "resultado": "A notícia se espalha: a garota que responde as cartas. A fama sobe."
